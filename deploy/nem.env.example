# Copy to /etc/nem/nem.env, then: chown root:nem /etc/nem/nem.env && chmod 640 /etc/nem/nem.env
# Secrets live here, never in portfolio files or git.

# Google Sheets reporter (optional): path to the service-account key, and the sheet ID.
# SHEETS_CREDENTIALS=/etc/nem/sheets-service-account.json
# SHEET_ID=

# Live trading (planned, M8). Not used by paper trading.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/etc/nem/kalshi.pem
